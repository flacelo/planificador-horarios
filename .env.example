# PLANIFY - Calendar Integration
# Rename this file to .env and fill in your credentials

# Google Calendar OAuth2
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Apple Calendar (sign-in-with-apple)
VITE_APPLE_DEVELOPER_TOKEN=your-apple-developer-token

# Token privado para las rutas administrativas locales.
# Usa un valor largo y aleatorio; nunca lo publiques ni lo pongas en el frontend.
PLANIFY_ADMIN_TOKEN=replace-with-a-long-random-token
